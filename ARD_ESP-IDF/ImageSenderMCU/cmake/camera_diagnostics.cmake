# esp32-camera prints FB-OVF through ets_printf, bypassing esp_log_level_set.
# Patch only those two task-context prints in a generated build source. All
# driver error handling and the downloaded component remain unchanged.
idf_component_get_property(ard_camera_dir espressif__esp32-camera COMPONENT_DIR)
idf_component_get_property(ard_camera_lib espressif__esp32-camera COMPONENT_LIB)
set(ard_camera_hal "${ard_camera_dir}/driver/cam_hal.c")
file(READ "${ard_camera_hal}" ard_camera_source)
set(ard_overflow_print [=[ESP_CAMERA_ETS_PRINTF(DRAM_STR("cam_hal: FB-OVF\r\n"));]=])
string(REPLACE "${ard_overflow_print}" "" ard_without_prints "${ard_camera_source}")
string(LENGTH "${ard_camera_source}" ard_before)
string(LENGTH "${ard_without_prints}" ard_after)
string(LENGTH "${ard_overflow_print}" ard_print_length)
math(EXPR ard_removed "${ard_before} - ${ard_after}")
math(EXPR ard_expected "2 * ${ard_print_length}")
if(NOT ard_removed EQUAL ard_expected)
    message(FATAL_ERROR "Camera FB-OVF diagnostic patch expected two known prints. Check esp32-camera version before building.")
endif()
string(REPLACE "${ard_overflow_print}" "ard_camera_report_overflow();" ard_camera_source "${ard_camera_source}")
set(ard_camera_generated "${CMAKE_CURRENT_BINARY_DIR}/ard_camera/cam_hal.c")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/ard_camera")
file(WRITE "${ard_camera_generated}" "#include \"cam_overflow_log.h\"\n${ard_camera_source}")

get_target_property(ard_camera_sources ${ard_camera_lib} SOURCES)
set(ard_camera_replaced FALSE)
set(ard_camera_new_sources "")
foreach(ard_camera_file IN LISTS ard_camera_sources)
    get_filename_component(ard_camera_absolute "${ard_camera_file}" ABSOLUTE BASE_DIR "${ard_camera_dir}")
    if(ard_camera_absolute STREQUAL ard_camera_hal)
        list(APPEND ard_camera_new_sources "${ard_camera_generated}")
        set(ard_camera_replaced TRUE)
    else()
        list(APPEND ard_camera_new_sources "${ard_camera_file}")
    endif()
endforeach()
if(NOT ard_camera_replaced)
    message(FATAL_ERROR "Camera HAL source was not found in the camera component target")
endif()
set_property(TARGET ${ard_camera_lib} PROPERTY SOURCES "${ard_camera_new_sources}")
target_include_directories(${ard_camera_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../main")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ard_camera_hal}")
