CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3 N16R8: 16 MB QIO flash, 8 MB octal PSRAM (same as the Arduino build)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 160 MHz was verified stable with camera + Wi-Fi (results/261003 report).
# Brownout detection stays at the SDK default (enabled).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# 1 ms tick so short back-off waits in img_tx.c are real milliseconds.
CONFIG_FREERTOS_HZ=1000

# Wi-Fi / lwIP buffers for bursts of 32 x 1.4 KB datagrams per window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
# With PSRAM Wi-Fi allocation IDF only offers static TX buffers; 32 = one window.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# esp32-camera: frame buffers in PSRAM
CONFIG_CAMERA_TASK_STACK_SIZE=4096

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
