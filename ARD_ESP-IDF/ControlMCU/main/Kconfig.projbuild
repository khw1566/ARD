menu "ARD ControlMCU"

    config CONTROL_DEFAULT_SERVER
        string "Default PC server host"
        default "10.115.5.12"
        help
            IPv4, DNS name or name.local of the PC running the ARD server (port 5000).
            Used until a server is saved on the board's /network settings page.

    config CONTROL_DEFAULT_VOLUME
        int "Volume before one is saved (0-21)"
        range 0 21
        default 12

    config CONTROL_PREBUFFER_MS
        int "Voice jitter buffer before playback starts (ms)"
        range 0 300
        default 96
        help
            The PC sends 32 ms PCM packets. Waiting for a few of them before the
            first sample absorbs Wi-Fi jitter; the Arduino build played each packet
            as it arrived and clicked whenever one was late.

    config CONTROL_BOOT_MELODY
        bool "Play the boot melody"
        default y

endmenu
