CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# PlatformIO used huge_app.csv; the single large app partition gives 1.5 MB.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Scheduler: 1 kHz tick so the motion task can run every millisecond.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Task watchdog: motion / sensors / tcp_cmd subscribe; a hung task resets the board.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Keep the step ISR running while flash is busy.
CONFIG_GPTIMER_ISR_IRAM_SAFE=y

# Network stacks on core 0, motion owns core 1.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_LOCAL_HOSTNAME="ard-drive"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# SNTP uses pool.ntp.org and time.google.com.
CONFIG_LWIP_SNTP_MAX_SERVERS=2
